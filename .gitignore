# ROS2 colcon build artifacts
# 앞에 / 를 붙이지 않는다 — 워크스페이스 루트가 아닌 곳에서 colcon 을 돌리면
# 거기에도 build/install/log 가 생기는데, 루트 고정 패턴은 그걸 못 잡는다.
build/
install/
log/

# Runtime data logs
/log_csv/

# 보정·설정은 config/ 에 둔다 — log_csv/ 는 지워도 되는 곳이라 정리 한 번에
# 같이 날아간다(2026-08-25 에 실제로 지자기 보정 파일을 그렇게 잃었다).
# mag_calib_params.txt 와 port_map.txt 는 **일부러 추적한다** — 지워져도
# git checkout 으로 되살릴 수 있는 것이 이 이사의 핵심이다.
# hydro_zero.txt 만 뺀다: 영점을 잡을 때마다 바뀌어 커밋 잡음이 된다.
/config/hydro_zero.txt

# Editor / OS cruft
*.swp
*~
.DS_Store
.vscode/

# 파이썬 바이트코드 (launch/scripts 실행 시 자동 생성)
__pycache__/
*.pyc
